import { Injectable } from '@nestjs/common'
import { ${serviceName} } from './entity/${serviceName}.entity'
import { BaseService } from 'src/base-module/base.service'
import { DeepPartial, FindManyOptions, FindOptionsWhere, Repository } from 'typeorm'
import { InjectRepository } from '@nestjs/typeorm'

@Injectable()
export default class ${serviceName}Service extends BaseService<${serviceName}> {
  constructor(
    @InjectRepository(${serviceName})
    private repository: Repository<${serviceName}>
  ) {
    super();
  }

  async create(data: DeepPartial<${serviceName}>): Promise<${serviceName}> {
    return this.repository.create(data)
  }

  async findAll(options?: FindManyOptions<${serviceName}>): Promise<${serviceName}[]> {
    return this.repository.find()
  }
  
  async findOneById(id: any): Promise<${serviceName} | null> {
    return this.repository.findOne({ where: { id: id } });
  }

  findOneBy(where: FindOptionsWhere<${serviceName}>): Promise<${serviceName}> {
    return this.repository.findOneBy(where)
  }

  async update(id: any, data: Partial<${serviceName}>): Promise<void> {
    return this.update(id, data)
  }

  async delete(id: any): Promise<void> {
    return this.delete(id)
  }
}
